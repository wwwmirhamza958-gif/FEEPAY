{
  "openapi": "3.1.1",
  "info": {
    "title": "FeePlatform.Api | v1",
    "description": "Fee Platform API. Error bodies use CONTRACT section 3 envelope (components.schemas.ApiError).",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "operationId": "Health",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/internal/outbox/dispatch": {
      "post": {
        "tags": [
          "System"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/v1/auth/otp/challenge": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "OtpChallenge",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpChallengeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OtpChallengeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/otp/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "OtpVerify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OtpVerifyRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/portal/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "PortalLogin",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PortalLoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          },
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/portal/totp/verify": {
      "post": {
        "tags": [
          "Auth"
        ],
        "operationId": "PortalTotpVerify",
        "responses": {
          "501": {
            "description": "Not Implemented",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "code",
          "message",
          "messageKey",
          "correlationId",
          "details",
          "retryable"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "description": "SCREAMING_SNAKE_CASE stable code."
          },
          "message": {
            "type": "string"
          },
          "messageKey": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ApiErrorBody": {
        "required": [
          "code",
          "message",
          "messageKey",
          "correlationId",
          "details",
          "retryable"
        ],
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "messageKey": {
            "type": "string"
          },
          "correlationId": {
            "type": "string",
            "format": "uuid"
          },
          "details": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiErrorDetail"
            }
          },
          "retryable": {
            "type": "boolean"
          }
        }
      },
      "ApiErrorDetail": {
        "required": [
          "field",
          "code",
          "message",
          "messageKey"
        ],
        "type": "object",
        "properties": {
          "field": {
            "type": [
              "null",
              "string"
            ],
            "description": "Property path or null for non-field errors."
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "messageKey": {
            "type": "string"
          }
        }
      },
      "ApiErrorEnvelope": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ApiError"
          }
        }
      },
      "AuthSessionResponse": {
        "required": [
          "sessionId",
          "accessToken",
          "refreshToken"
        ],
        "type": "object",
        "properties": {
          "sessionId": {
            "type": "string",
            "format": "uuid"
          },
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        }
      },
      "OtpChallengeRequest": {
        "required": [
          "mobile"
        ],
        "type": "object",
        "properties": {
          "mobile": {
            "type": "string"
          }
        }
      },
      "OtpChallengeResponse": {
        "required": [
          "challengeId",
          "expiresAtUtc",
          "devCode"
        ],
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "devCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "OtpVerifyRequest": {
        "required": [
          "challengeId",
          "code"
        ],
        "type": "object",
        "properties": {
          "challengeId": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "PortalLoginRequest": {
        "required": [
          "email",
          "password",
          "totpCode"
        ],
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "totpCode": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "Auth"
    }
  ]
}